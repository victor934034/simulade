# Simulaê — copie este arquivo para ".env" e preencha a chave.
#   Windows:     copy .env.example .env
#   Linux/macOS: cp .env.example .env
# O arquivo .env NUNCA vai para o GitHub (está no .gitignore).

# Chave da API da Anthropic (https://console.anthropic.com → API Keys).
# Deixe vazia para usar o modo demonstração (IA simulada, sem custo).
ANTHROPIC_API_KEY=

# Vazio = usa "anthropic" se houver chave, senão "mock".
AI_PROVIDER=

# ── Modelos ─────────────────────────────────────────────────────────────
# Configuração ECONÔMICA (boa para poucos créditos):
MODEL_GERACAO=claude-sonnet-5-5
MODEL_VALIDACAO=claude-haiku-4-5
MODEL_AVALIACAO=claude-sonnet-5-5
# Configuração de MÁXIMA QUALIDADE (mais cara), se quiser trocar:
# MODEL_VALIDACAO=claude-sonnet-5-5
# MODEL_AVALIACAO=claude-opus-5-5

# Chamadas simultâneas à IA.
AI_CONCURRENCY=4

# Porta do site (http://localhost:PORTA). Se a 3000 estiver ocupada, use 3001.
PORT=3000

# Pasta onde as provas ficam salvas.
DATA_DIR=./data

# Opcional: se definido, o site pede este código antes de liberar o uso.
ACCESS_CODE=

# Provas que cada visitante pode criar a cada 24 horas.
MAX_PROVAS_POR_DIA=6

# Atraso das respostas no modo demonstração (ms).
MOCK_DELAY_MS=15
